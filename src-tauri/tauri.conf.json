{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstroHour",
  "version": "0.1.0",
  "identifier": "com.astrohour.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AstroHour",
        "width": 380,
        "height": 520,
        "minWidth": 320,
        "minHeight": 400,
        "maxWidth": 600,
        "maxHeight": 800,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "autostart": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
