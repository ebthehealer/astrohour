{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstroHour",
  "version": "0.1.0",
  "identifier": "com.astrohour.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AstroHour",
        "width": 380,
        "height": 520,
        "minWidth": 320,
        "minHeight": 400,
        "maxWidth": 600,
        "maxHeight": 800,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "plugins": {
    "autostart": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Planetary Hours in your status bar",
    "longDescription": "AstroHour shows the current planetary hour, moon phase, and lunar day in your system status bar. Includes a full 24-hour schedule, notes per planetary hour, hour-change notifications, and multiple color themes. Free and fully featured on Linux.",
    "linux": {
      "deb": {
        "section": "science",
        "priority": "optional",
        "depends": [
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "desktopTemplate": "../packaging/astrohour.desktop.hbs"
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "../packaging/astrohour.desktop.hbs",
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
