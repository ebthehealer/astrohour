# Copy to .env and fill in — then use `wrangler secret put` for each
# DO NOT commit .env or any real key values

# From Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# From Stripe Dashboard > Developers > API keys (secret key)
STRIPE_SECRET_KEY=sk_live_...

# Raw 32-byte Ed25519 private key seed as lowercase hex (64 chars)
# Generated with: openssl pkey -in private.pem -outform DER | tail -c 32 | xxd -p | tr -d '\n'
ED25519_PRIVATE_KEY_HEX=2f60ac418259... (your actual key)

# From resend.com > API Keys
RESEND_API_KEY=re_...
